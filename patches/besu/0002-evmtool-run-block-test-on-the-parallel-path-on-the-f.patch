From dd8145a6da7690370fa57256c23796f08e9c0651 Mon Sep 17 00:00:00 2001
From: Felipe Selmo <fselmo2@gmail.com>
Date: Wed, 23 Sep 2026 22:16:37 +0000
Subject: [PATCH 2/3] evmtool: run block-test on the parallel path, on the
 fixture's access list

block-test built its schedule with parallel processing off and called the
importBlock overload that passes Optional.empty() for the block access list,
so the list the fixture already parses never reached the processor and
besu judged every fixture on the sequential path. The list is now delivered
and the parallel processor is the default, which is what a Bonsai node runs;
--bal.sequential selects the old path, so the same binary can judge a shard
both ways.

Probed at ParallelTransactionPreprocessing.run on a 500-fixture shard:
500 of 500 blocks took BalConcurrentTransactionProcessor, none the
optimistic scheduler, none skipped preprocessing, none fell back; with
--bal.sequential, 0 of 500. Verdicts 500/500 both ways. A fixture whose
delivered list drops one account passes on the stock runner and is
rejected here.
---
 .../besu/evmtool/BlockchainTestSubCommand.java   | 16 ++++++++++++++--
 1 file changed, 14 insertions(+), 2 deletions(-)

diff --git a/ethereum/evmtool/src/main/java/org/hyperledger/besu/evmtool/BlockchainTestSubCommand.java b/ethereum/evmtool/src/main/java/org/hyperledger/besu/evmtool/BlockchainTestSubCommand.java
index bde5f217bc..79b9ac9549 100644
--- a/ethereum/evmtool/src/main/java/org/hyperledger/besu/evmtool/BlockchainTestSubCommand.java
+++ b/ethereum/evmtool/src/main/java/org/hyperledger/besu/evmtool/BlockchainTestSubCommand.java
@@ -125,6 +125,13 @@ public class BlockchainTestSubCommand implements Runnable {
       description = "Verbose logs, listing all skipped tests")
   private final Boolean verbose = false;
 
+  @Option(
+      names = {"--bal.sequential"},
+      description =
+          "Process each block sequentially. Without it the parallel block processor runs, "
+              + "scheduling from the block access list the fixture delivers.")
+  private final Boolean balSequential = false;
+
   @ParentCommand private final EvmToolCommand parentCommand;
 
   // picocli does it magically
@@ -301,7 +308,7 @@ public class BlockchainTestSubCommand implements Runnable {
             .orElseThrow();
 
     final ProtocolSchedule schedule =
-        ReferenceTestProtocolSchedules.create(parentCommand.getEvmConfiguration())
+        ReferenceTestProtocolSchedules.create(parentCommand.getEvmConfiguration(), !balSequential)
             .getByName(spec.getNetwork());
 
     BlockTestTracerManager tracerManager = null;
@@ -363,7 +370,12 @@ public class BlockchainTestSubCommand implements Runnable {
         final Stopwatch timer = Stopwatch.createStarted();
 
         final BlockImportResult importResult =
-            blockImporter.importBlock(context, block, validationMode, validationMode);
+            blockImporter.importBlock(
+                context,
+                block,
+                validationMode,
+                validationMode,
+                candidateBlock.getBlockAccessList());
 
         timer.stop();
 
