From 1e7dbb0e742b6ae4dda252c868cedd2d355afa6e Mon Sep 17 00:00:00 2001
From: Felipe Selmo <fselmo2@gmail.com>
Date: Tue, 29 Sep 2026 02:59:27 +0000
Subject: [PATCH] PROBE: print each block that reaches
 ParallelTransactionPreprocessing.run

---
 .../ParallelTransactionPreprocessing.java                | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/ethereum/core/src/main/java/org/hyperledger/besu/ethereum/mainnet/parallelization/ParallelTransactionPreprocessing.java b/ethereum/core/src/main/java/org/hyperledger/besu/ethereum/mainnet/parallelization/ParallelTransactionPreprocessing.java
index 1dc45f27d..a26695c4b 100644
--- a/ethereum/core/src/main/java/org/hyperledger/besu/ethereum/mainnet/parallelization/ParallelTransactionPreprocessing.java
+++ b/ethereum/core/src/main/java/org/hyperledger/besu/ethereum/mainnet/parallelization/ParallelTransactionPreprocessing.java
@@ -57,6 +57,15 @@ public class ParallelTransactionPreprocessing implements PreprocessingFunction {
       final Optional<BlockAccessListBuilder> blockAccessListBuilder,
       final Optional<BlockAccessList> maybeBlockBal,
       final Optional<BlockHeader> maybeParentHeader) {
+    System.err.println(
+        "FUZZ-PAR-PROBE block="
+            + blockHeader.getNumber()
+            + " pathbased="
+            + (protocolContext.getWorldStateArchive() instanceof PathBasedWorldStateProvider)
+            + " bal="
+            + maybeBlockBal.isPresent()
+            + " perfect="
+            + balConfiguration.isPerfectParallelizationEnabled());
     if (!(protocolContext.getWorldStateArchive() instanceof PathBasedWorldStateProvider)) {
       return Optional.empty();
     }
-- 
