 tooling/ef_tests/engine/bin/enginetest.rs | 58 +++++++++++++++++++++++
 tooling/ef_tests/engine/src/engine_ctx.rs | 24 ++++++++--
 3 files changed, 82 insertions(+), 4 deletions(-)
 create mode 100644 tooling/ef_tests/engine/bin/enginetest.rs

diff --git a/tooling/ef_tests/engine/Cargo.toml b/tooling/ef_tests/engine/Cargo.toml
index 8295ed8f3..c116e79a2 100644
--- a/tooling/ef_tests/engine/Cargo.toml
+++ b/tooling/ef_tests/engine/Cargo.toml
@@ -38,6 +38,10 @@ ctor = "0.2"
 [lib]
