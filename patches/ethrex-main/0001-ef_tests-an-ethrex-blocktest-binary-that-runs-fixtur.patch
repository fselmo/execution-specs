+/// The block access list a fixture delivers with a block, as `engine_newPayload`
+/// would hand it to the client, converted from the fixture's camelCase hex JSON.
+#[cfg(not(feature = "stateless"))]
+fn delivered_bal(block_fixture: &BlockWithRLP) -> Result<Option<Arc<BlockAccessList>>, String> {
+    use ethrex_common::types::block_access_list::{
+        AccountChanges, BalanceChange, CodeChange, NonceChange, SlotChange, StorageChange,
+    };
+    use ethrex_common::{Address, Bytes, U256};
+    use serde_json::Value;
+
+    let Some(Value::Array(accounts)) = block_fixture
+        .block()
+        .and_then(|block| block.block_access_list_data.as_ref())
+    else {
+        return Ok(None);
+    };
+    fn text<'a>(v: &'a Value, key: &str) -> Result<&'a str, String> {
+        v.get(key)
+            .and_then(Value::as_str)
+            .ok_or_else(|| format!("blockAccessList: missing {key}"))
+    }
+    fn word(s: &str) -> Result<U256, String> {
+        U256::from_str_radix(s.trim_start_matches("0x"), 16).map_err(|e| format!("{s}: {e}"))
+    }
+    fn index(v: &Value) -> Result<u32, String> {
+        u32::try_from(word(text(v, "blockAccessIndex")?)?).map_err(|e| e.to_string())
+    }
+    fn list<'a>(v: &'a Value, key: &str) -> &'a [Value] {
+        v.get(key).and_then(Value::as_array).map_or(&[], Vec::as_slice)
+    }
+    let mut out = Vec::with_capacity(accounts.len());
+    for account in accounts {
+        let address: Address = text(account, "address")?
+            .parse()
+            .map_err(|e| format!("blockAccessList address: {e:?}"))?;
+        let mut changes = AccountChanges::new(address);
+        for slot in list(account, "storageChanges") {
+            let mut slot_changes = Vec::new();
+            for change in list(slot, "slotChanges") {
+                slot_changes.push(StorageChange::new(index(change)?, word(text(change, "postValue")?)?));
+            }
+            changes.storage_changes.push(SlotChange {
+                slot: word(text(slot, "slot")?)?,
+                slot_changes,
+            });
+        }
+        for read in list(account, "storageReads") {
+            let read = read.as_str().ok_or("blockAccessList: storageReads entry")?;
+            changes.storage_reads.push(word(read)?);
+        }
+        for change in list(account, "balanceChanges") {
+            changes.balance_changes.push(BalanceChange {
+                block_access_index: index(change)?,
+                post_balance: word(text(change, "postBalance")?)?,
+            });
+        }
+        for change in list(account, "nonceChanges") {
+            changes.nonce_changes.push(NonceChange {
+                block_access_index: index(change)?,
+                post_nonce: u64::try_from(word(text(change, "postNonce")?)?)
+                    .map_err(|e| e.to_string())?,
+            });
+        }
+        for change in list(account, "codeChanges") {
+            let code = text(change, "newCode")?;
+            changes.code_changes.push(CodeChange {
+                block_access_index: index(change)?,
+                new_code: Bytes::from(
+                    hex::decode(code.trim_start_matches("0x")).map_err(|e| e.to_string())?,
+                ),
+            });
+        }
+        out.push(changes);
+    }
+    Ok(Some(Arc::new(BlockAccessList::from_accounts(out))))
+}
+
+/// Run a fixture's blocks with the access lists it delivers, on the parallel
+/// path unless `sequential`, then check the post-state. A fixture-level
+/// verdict for an external runner; a post-state mismatch panics, as in `run`.
+#[cfg(not(feature = "stateless"))]
+pub async fn run_with_delivered_bal(
+    test_key: &str,
+    test: &TestUnit,
+    sequential: bool,
+) -> Result<(), String> {
+    use ethrex_blockchain::BlockchainOptions;
+
+    let store = build_store_for_test(test).await;
+    check_prestate_against_db(test_key, test, &store);
+    let options = BlockchainOptions {
+        bal_parallel_exec_enabled: !sequential,
+        mempool_prewarm_enabled: false,
+        ..Default::default()
+    };
+    let blockchain = Blockchain::new(store.clone(), options);
+    for block_fixture in &test.blocks {
+        if block_fixture.expect_exception.is_some() && exception_in_rlp_decoding(block_fixture) {
+            return Ok(());
+        }
+    }
+    for block_fixture in &test.blocks {
+        let expects_exception = block_fixture.expect_exception.is_some();
+        let block: CoreBlock = block_fixture.block().unwrap().clone().into();
+        let hash = block.hash();
+        let bal = delivered_bal(block_fixture)?;
+        match blockchain.add_block_pipeline(block, bal) {
+            Err(error) => {
+                if !expects_exception {
+                    return Err(format!("block {hash:#x} unexpectedly failed: {error:?}"));
+                }
+            }
+            Ok(()) => {
+                if expects_exception {
+                    return Err(format!(
+                        "block {hash:#x} was expected to fail with {:?}",
+                        block_fixture.expect_exception
+                    ));
+                }
+                apply_fork_choice(&store, hash, hash, hash, None)
+                    .await
+                    .map_err(|e| format!("fork choice on {hash:#x}: {e:?}"))?;
+            }
+        }
+    }
+    check_poststate_against_db(test_key, test, &store).await;
+    Ok(())
+}
