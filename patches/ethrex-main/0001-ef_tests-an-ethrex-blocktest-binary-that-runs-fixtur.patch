+//! Run `blockchain_test` fixture files and print one JSON verdict per fixture.
+//!
+//! `ethrex-blocktest [--bal.sequential] FILE...` feeds each block the access list its
+//! fixture delivers, on the parallel path unless `--bal.sequential` is given,
+//! and prints a JSON array of `{name, pass, fork, error}` to stdout.
+
+use std::panic::{AssertUnwindSafe, catch_unwind};
+use std::path::Path;
+
+use ef_tests_blockchain::test_runner::{parse_tests, run_with_delivered_bal};
+
+fn main() {
+    let mut sequential = false;
+    let mut files = Vec::new();
+    for arg in std::env::args().skip(1) {
+        if arg == "--version" {
+            println!("ethrex-blocktest {}", env!("CARGO_PKG_VERSION"));
+            return;
+        } else if arg == "--bal.sequential" {
+            sequential = true;
+        } else {
+            files.push(arg);
+        }
+    }
+    let rt = tokio::runtime::Runtime::new().expect("tokio runtime");
+    let mut results = Vec::new();
+    for file in &files {
+        let mut tests: Vec<_> = parse_tests(Path::new(file)).into_iter().collect();
+        tests.sort_by(|a, b| a.0.cmp(&b.0));
+        for (name, test) in tests {
+            let outcome = catch_unwind(AssertUnwindSafe(|| {
+                rt.block_on(run_with_delivered_bal(&name, &test, sequential))
+            }));
+            let error = match outcome {
+                Ok(Ok(())) => String::new(),
+                Ok(Err(e)) => e,
+                Err(panic) => panic
+                    .downcast_ref::<String>()
+                    .cloned()
+                    .or_else(|| panic.downcast_ref::<&str>().map(|s| s.to_string()))
+                    .unwrap_or_else(|| "panicked".to_string()),
+            };
+            results.push(serde_json::json!({
+                "name": name,
+                "pass": error.is_empty(),
+                "fork": format!("{:?}", test.network),
+                "error": error,
+            }));
+        }
+    }
+    println!("{}", serde_json::to_string_pretty(&results).expect("verdicts serialize"));
+}
