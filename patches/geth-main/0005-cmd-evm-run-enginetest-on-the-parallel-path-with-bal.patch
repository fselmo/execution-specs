From 4b9a06406fb912be1310a228c06ed41a77bae6c7 Mon Sep 17 00:00:00 2001
From: Felipe Selmo <fselmo2@gmail.com>
Date: Tue, 29 Sep 2026 03:01:22 +0000
Subject: [PATCH 5/5] cmd/evm: run enginetest on the parallel path, with
 --bal.sequential

enginetest built its chain with a bare vm.Config, so parallel execution was on and nothing could turn it off. It now takes 0001's --bal.sequential and passes it as DisableParallelExecution, so the same binary judges a payload both ways.
---
 cmd/evm/enginerunner.go   | 3 ++-
 tests/engine_test_util.go | 4 ++--
 2 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/cmd/evm/enginerunner.go b/cmd/evm/enginerunner.go
index 3a96cc7e0..fd136de5e 100644
--- a/cmd/evm/enginerunner.go
+++ b/cmd/evm/enginerunner.go
@@ -54,6 +54,7 @@ var engineTestCommand = &cli.Command{
 		RunFlag,
 		FuzzFlag,
 		WorkersFlag,
+		SequentialFlag,
 	}, traceFlags),
 }
 
@@ -193,7 +194,7 @@ func runEngineTest(ctx *cli.Context, fname string) ([]testResult, error) {
 		test := testsByName[name]
 		result := &testResult{Name: name, Pass: true}
 		var finalHash *common.Hash
-		if err := test.Run(rawdb.PathScheme, tracer, func(res error, chain *core.BlockChain) {
+		if err := test.Run(rawdb.PathScheme, ctx.Bool(SequentialFlag.Name), tracer, func(res error, chain *core.BlockChain) {
 			if ctx.Bool(DumpFlag.Name) {
 				if s, _ := chain.State(); s != nil {
 					result.State = dump(s)
diff --git a/tests/engine_test_util.go b/tests/engine_test_util.go
index f0b50b2ad..709c699c9 100644
--- a/tests/engine_test_util.go
+++ b/tests/engine_test_util.go
@@ -152,7 +152,7 @@ func (p *etNewPayload) UnmarshalJSON(data []byte) error {
 }
 
 // Run executes the engine test.
-func (t *EngineTest) Run(scheme string, tracer *tracing.Hooks, postCheck func(error, *core.BlockChain)) (result error) {
+func (t *EngineTest) Run(scheme string, sequential bool, tracer *tracing.Hooks, postCheck func(error, *core.BlockChain)) (result error) {
 	config, ok := Forks[t.json.Network]
 	if !ok {
 		return UnsupportedForkError{t.json.Network}
@@ -192,7 +192,7 @@ func (t *EngineTest) Run(scheme string, tracer *tracing.Hooks, postCheck func(er
 		StateScheme:    scheme,
 		Preimages:      true,
 		TxLookupLimit:  -1,
-		VmConfig:       vm.Config{Tracer: tracer},
+		VmConfig:       vm.Config{Tracer: tracer, DisableParallelExecution: sequential},
 		NoPrefetch:     true,
 	}
 	chain, err := core.NewBlockChain(db, gspec, eng, options)
-- 
